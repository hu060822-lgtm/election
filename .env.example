# PostgreSQL connection string
DATABASE_URL=postgres://tew:tew_dev_pw@localhost:5432/tew
# API port (production serves the built web app from here too)
PORT=8787
# Admin password — REQUIRED, use a long random string in production
ADMIN_PASSWORD=change-me-to-a-long-random-string
# Set to "true" when served over HTTPS so cookies are Secure
COOKIE_SECURE=false
# Where uploaded candidate photos are stored
UPLOAD_DIR=./uploads
# Comma-separated allowed origins for the WebSocket / API (empty = same origin only)
ALLOWED_ORIGINS=http://localhost:5173
# Join / restore attempts allowed per IP per 15 minutes
IDENTITY_RATE_LIMIT=30
